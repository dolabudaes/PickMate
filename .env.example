# Copy to `.env` and fill locally. Never commit `.env`.

APP_ENV=development
SQLITE_PATH=apps/api/data/pickmate-app.db

LLM_MODE=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

PICKI_MODEL_BASE_URL=
PICKI_MODEL_API_KEY=
PICKI_MODEL_NAME=

PICKI_SEARCH_PROVIDER=
PICKI_SEARCH_API_KEY=
PICKI_SEARCH_API_BASE_URL=

# Frontend only. Do not put API keys in EXPO_PUBLIC_* — those are bundled into the client.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8011
EXPO_PUBLIC_DEMO_MODE=true
