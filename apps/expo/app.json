{
  "expo": {
    "name": "PickMate",
    "slug": "pickmate",
    "scheme": "pickmate",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "PickMate"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {},
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
